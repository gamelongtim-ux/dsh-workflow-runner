{
  "name": "dsh-workflow-runner",
  "version": "0.1.5",
  "description": "Bring ZCode-style dynamic-workflows semantics into dsh: write JS workflow scripts that spawn parallel LLM agents and shell gates; live progress streams to the chat UI as overlay cards.",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "workflow",
    "agents",
    "cordis",
    "orchestration",
    "llm"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "type": "module",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./plugin": "./lib/plugin.js",
    "./runner-bootstrap": "./lib/runner-bootstrap.mjs",
    "./standalone": "./lib/standalone.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "public",
    "samples",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamelongtim-ux/dsh-workflow-runner.git"
  },
  "bugs": {
    "url": "https://github.com/gamelongtim-ux/dsh-workflow-runner/issues"
  },
  "homepage": "https://github.com/gamelongtim-ux/dsh-workflow-runner#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}

