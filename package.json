{
  "name": "dsh-workflow-runner",
  "version": "0.1.1",
  "description": "Bring ZCode-style dynamic-workflows to dsh: write JS workflow scripts that spawn parallel LLM agents and shell gates; live progress streams to the chat UI as overlay cards.",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "workflow",
    "agents",
    "cordis",
    "orchestration"
  ],
  "type": "module",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./plugin": "./lib/plugin.js",
    "./runner-bootstrap": "./lib/runner-bootstrap.mjs",
    "./standalone": "./lib/standalone.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
